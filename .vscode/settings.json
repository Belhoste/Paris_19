{
  // Masquer les décorations diff dans la gouttière
  "scm.diffDecorations": "none",
  "scm.diffDecorationsGutterWidth": 1,

  // Désactiver les annotations bruyantes GitLens
  "gitlens.currentLine.enabled": false,
  "gitlens.lineAnnotations.enabled": "off",
  "gitlens.codeLens.enabled": false,
  "gitlens.blame.line.enabled": false,
  "gitlens.heatmap.enabled": false,

  // Garder les hovers possibles (optionnel)
  "gitlens.hovers.currentLine.over": "line"
  ,
  // Désactiver totalement les hovers GitLens
  "gitlens.hovers.enabled": false,
  // Désactiver l'élément de barre d'état GitLens
  "gitlens.statusBar.enabled": false,
  // Masquer les pastilles / couleurs de l'explorateur
  "explorer.decorations.colors": false,
  "explorer.decorations.badges": false,
  // Désactiver totalement les décorations Git (icônes de statut) dans l'explorateur
  "git.decorations.enabled": false
  ,
  // Désactiver badges / couleurs sur les onglets (éditeur)
  "workbench.editor.decorations.badges": false,
  "workbench.editor.decorations.colors": false,
  // Réduire colorisations avancées susceptibles de prêter à confusion
  "editor.bracketPairColorization.enabled": false,
  "editor.semanticHighlighting.enabled": false
  ,
  // Désactiver autres surbrillances internes
  "editor.selectionHighlight": false,
  "editor.occurrencesHighlight": "off",
  "editor.inlayHints.enabled": "off",
  "editor.renderLineHighlight": "none",
  // Désactiver les guides d'indentation
  "editor.guides.indentation": false,
  "editor.guides.highlightActiveIndentation": false,
  // Désactiver CodeLens global (références au-dessus des fonctions)
  "editor.codeLens": false,
  // Désactiver CodeLens TS/JS (références/implémentations)
  "typescript.referencesCodeLens.enabled": false,
  "javascript.referencesCodeLens.enabled": false,
  "typescript.implementationsCodeLens.enabled": false,
  "javascript.implementationsCodeLens.enabled": false,
  // Optionnel: désactiver complètement les hovers éditeur (si encore gênants)
  // "editor.hover.enabled": false,
  // Désactiver inline suggest/ghost text (Copilot & co)
  "editor.inlineSuggest.enabled": false,
  // Neutraliser les fonds verts/rouges même en cas d'ouverture accidentelle d'un diff
  "workbench.colorCustomizations": {
    "diffEditor.insertedLineBackground": "#00000000",
    "diffEditor.removedLineBackground": "#00000000",
    "diffEditor.insertedTextBackground": "#00000000",
    "diffEditor.removedTextBackground": "#00000000"
  },
  // Ouvrir le fichier direct (pas la vue diff) quand on clique dans Contrôle de code source
  "git.openDiffOnClick": false
  ,
  // Désactiver sticky scroll et navigation de diff incrustée
  "editor.stickyScroll.enabled": false,
  "diffEditor.codeLens": false,
  "diffEditor.showMoveAnnotations": false,
  "diffEditor.hideUnchangedRegions.enabled": false
}
